# 系統檔
.DS_Store

# 執行期資料（SQLite、上傳附件）
webgl-prototype/data/

# 舊版封存
archive/

# 大型 3D 模型與 Blender 原始檔（約 3 GB；版本以檔名 vNN 與 scene/assets.json 登記）
*.glb
*.blend
*.blend1

# 截圖與渲染圖；保留權威參考圖與網頁執行需要的貼圖
*.png
*.jpg
*.jpeg
*.webp
!visual-references/**
!webgl-prototype/assets/*.png
!webgl-prototype/assets/*.jpg
!webgl-prototype/dist/assets/*.png
!webgl-prototype/dist/assets/*.jpg

# 記錄檔與 Python 快取
*.log
__pycache__/

# 本機工具、套件、雲端憑證與部署產物
.tools/
.claude/
node_modules/
.netlify/
public/
.env
.env.*
!.env.example
*.sqlite*
*.db
*.pem
*.key
skills/validation/

# 網站實際使用資產：由 deployment/assets.json 與 build-site.mjs 管理
!webgl-prototype/assets/characters/**/*.glb
!webgl-prototype/assets/character-study/reference.jpg
!webgl-prototype/assets/film-character-reference/*.webp
!webgl-prototype/assets/poster-lighthouse-tower-v01.glb
!webgl-prototype/assets/ntucc-blender-v07.glb
